// === zBASKET v2.1 — 5-Pillar Staking & Boost Matrix ===
module VelvetBasketStaking5Pillar {
    const TREASURY = "6C61wDacAtx3QHQYVw17fnm5GEaEAnc1XienNJKn2bsD";
    const DSN_MINT = "35w74RT77BPSYNpmzpvxmR9wu2ihpgzubKy4bkGHR3F4";
    const OV_MINT  = "2EN6Y1zM4yyt41gE2muzdJSAgRCAZiXqnmkgpbrspump";
    const LSD_PEG_EUR = 0.0064;
    const FEE_SHARE_BPS = 500;   // rZDOS: 5.00% swap & bridge fee share
    const MAX_BOOST_BPS = 20000; // bZDOS: fino a 2.00x (20000 bps)

    struct LockTier {
        days: u32,
        boost_bps: u32,
        vote_mult_bps: u32,
        izdos_tier: str,
    }

    fn tiers() -> [LockTier; 4] {
        return [
            LockTier { days: 0,  boost_bps: 10000, vote_mult_bps: 5000,  izdos_tier: "Standard" },
            LockTier { days: 7,  boost_bps: 12500, vote_mult_bps: 10000, izdos_tier: "Bronze Drop" },
            LockTier { days: 30, boost_bps: 16000, vote_mult_bps: 15000, izdos_tier: "Silver IFO" },
            LockTier { days: 90, boost_bps: 20000, vote_mult_bps: 20000, izdos_tier: "Sovereign VIP" },
        ];
    }

    fn bridge_to_vault_miner(lock_days: u32) -> u32 {
        if lock_days >= 90 { return 20000; }
        if lock_days >= 30 { return 16000; }
        if lock_days >= 7  { return 12500; }
        return 10000;
    }
}
