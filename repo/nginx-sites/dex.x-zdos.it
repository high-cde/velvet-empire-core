server {
    server_name dex.x-zdos.it;


    root /var/www/dex-xzdos;
    index index.html;

    location ^~ /api/vchain/ {
        proxy_pass http://127.0.0.1:8899/api/vchain/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
location /api/dex/ {
        proxy_pass http://127.0.0.1:8897/api/dex/;
        proxy_hide_header Content-Type;
        add_header Content-Type "application/json; charset=utf-8" always;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

        location = /api/rpc {
        proxy_pass http://127.0.0.1:8897/api/rpc;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Content-Type "application/json";
    }


location / {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        expires off;
        try_files $uri $uri/ /index.html;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/dex.x-zdos.it/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/dex.x-zdos.it/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = dex.x-zdos.it) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name dex.x-zdos.it;

    return 404; # managed by Certbot


}