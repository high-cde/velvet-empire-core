    server_name x-zdos.it;

    location ^~ /api/monetary/ {
        proxy_pass http://127.0.0.1:8890/api/monetary/;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }

    location ^~ /api/mining/ {
        proxy_pass http://127.0.0.1:8847;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    ssl_certificate /etc/letsencrypt/live/x-zdos.it/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/x-zdos.it/privkey.pem;
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
 # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/x-zdos-portal/current;
    index index.html;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Strict-Transport-Security "max-age=15552000" always;

    # DSN-X dx9: cache lunga per asset statici della home (versionati con ?v=)
    location ^~ /assets/fonts/ {
        types { font/woff2 woff2; text/css css; }
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=15552000" always;
        try_files $uri =404;
    }
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=2592000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=15552000" always;
        try_files $uri =404;
    }
    location = /favicon.ico { expires 30d; access_log off; try_files $uri =404; }
    location ~* ^/(nav\.js|sessions\.css)$ {
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Zlang IDE (statico)
    location = /ide { return 301 /ide/; }
    location ^~ /ide/ {
        alias /var/www/zlang-ide/current/;
        index index.html;
        types { text/html html; text/css css; application/javascript js; application/wasm wasm; image/svg+xml svg; }
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Cache-Control "no-cache" always;
    }

    # Bot Discord z-xSOLANA: pagina di verifica holder (statica) e API locale (servizio zdiscord)
    location = /discord/verify { return 301 /discord/verify/; }
    location ^~ /discord/verify/ {
        alias /var/www/zdiscord/verify/;
        index index.html;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Cache-Control "no-cache" always;
    }
    location ^~ /discord/api/ {
        proxy_pass http://127.0.0.1:8790;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        client_max_body_size 8k;
        proxy_read_timeout 30s;
    }

    # xCLOUD by ZDOS - gestionale MVP (statico, dati solo nel browser)
    location = /xcloud { return 301 /xcloud/; }
    location ^~ /xcloud/ {
        alias /var/www/xcloud/current/;
        index index.html;
        types { text/html html; text/css css; application/javascript js; image/svg+xml svg; application/manifest+json webmanifest; }
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
        add_header Cache-Control "no-cache" always;
    }

    # ZDESK reverse proxy (attivo su 127.0.0.1:8787)
    # DSN-X market-ready: redirect per link storici
    location = /zroute { return 301 https://swap.x-zdos.it/zroute/; }
    location ^~ /zroute/ { return 301 https://swap.x-zdos.it/zroute/; }
    location = /dsn { return 301 https://x-zdos.it/#token; }
    location = /dsn/ { return 301 https://x-zdos.it/#token; }
    location = /zdesk { return 301 /zdesk/; }
    location /zdesk/ {
        auth_basic "ZDESK";
        auth_basic_user_file /etc/nginx/zdesk.htpasswd;
        proxy_pass http://127.0.0.1:8787/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /zdesk;
        proxy_read_timeout 120s;
    }

    include /etc/nginx/snippets/zdos-agency.conf;

    # Portale sviluppatori Zlang (statico)
    include /etc/nginx/snippets/xzdos-merito.conf;
    location = /dev { return 301 /dev/; }
    location ^~ /dev/ {
