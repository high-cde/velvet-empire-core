# ZDOS Agency su agency.x-zdos.it (DSN-X market-ready). Resta con password finché doc non fissa nome e prezzi.
server {
    # === DOMCOIN_RPC_START ===
    location ^~ /dom-rpc {
        proxy_pass http://127.0.0.1:8896/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    # === DOMCOIN_RPC_END ===


    listen 80;
    listen [::]:80;
    server_name agency.x-zdos.it;
    location ^~ /api/monetary/ {
        proxy_pass http://127.0.0.1:8890/api/monetary/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}
server {
    # === DOMCOIN_RPC_START ===
    location ^~ /dom-rpc {
        proxy_pass http://127.0.0.1:8896/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    # === DOMCOIN_RPC_END ===


    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name agency.x-zdos.it;
    ssl_certificate /etc/letsencrypt/live/agency.x-zdos.it/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agency.x-zdos.it/privkey.pem;
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/zdos-agency;
    index index.html;
# [unlocked]     auth_basic "ZDOS Agency · accesso riservato";
# [unlocked]     auth_basic_user_file /etc/nginx/htpasswd-agency;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Cache-Control "no-store" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8760/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        client_max_body_size 24k;
    }
    location ~ /\. { deny all; }
    location = /forge { return 301 /forge/; }
    location ^~ /forge/ {
        alias /var/www/zdos-portal/;
        index forge.html;
        try_files /forge.html =404;
    }

    location ^~ /api/forge/ {
        proxy_pass http://127.0.0.1:8833/;
        proxy_set_header Host $host;
    }

    location / { try_files $uri $uri/ =404; }

}
